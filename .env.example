# Copy to .env. Do not commit .env.
#
# The live NSE command (python3 run_pipeline_local.py) needs nothing here.
# It uses the Yahoo chart endpoint for SYMBOL.NS and ignores the blocks below.

# --- Your market API (unused until a client is added) ---
# Leave these blank to keep Yahoo. Any TICKR_DATA_PROVIDER other than yahoo
# makes the runner exit before it calls out.
TICKR_DATA_PROVIDER=yahoo
TICKR_MARKET_API_BASE=
TICKR_MARKET_API_KEY=
TICKR_MARKET_SYMBOL_FORMAT=

# --- Optional US Kafka producer. Not used for NSE. ---
ALPHA_VANTAGE_API_KEY=

# --- Optional Compose stack. Defaults match docker-compose.yaml. ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REALTIME=stock-market-realtime
KAFKA_TOPIC_BATCH=stock-market-batch
KAFKA_GROUP_BATCH_ID=stock-market-batch-consumer-group
KAFKA_GROUP_REALTIME_ID=stock-market-realtime-consumer-group

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stock-market-data
MINIO_CONNECTION=http://minio:9000

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=STOCKMARKETBATCH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_TABLE=DAILY_STOCK_METRICS
